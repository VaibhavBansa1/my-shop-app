# Runtime connection: the least-privileged shop_app role (subject to RLS).
DATABASE_URL=postgres://shop_app:shop_app_dev@localhost:5432/shop_dev
# Migration connection: the shop_owner role that owns the schema.
DATABASE_OWNER_URL=postgres://shop_owner:shop_owner_dev@localhost:5432/shop_dev
# Public origin of the app, used for CSRF origin checks and invitation links.
APP_ORIGIN=http://localhost:3000
