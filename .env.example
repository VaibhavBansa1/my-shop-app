# ===========================================================================
# My Shop App — environment settings. Copy to .env.local and edit.
# Lines starting with # are comments. Never commit real keys or passwords.
# ===========================================================================

# --- Database --------------------------------------------------------------
# Runtime connection: the least-privileged shop_app role (subject to row-level security).
DATABASE_URL=postgres://shop_app:shop_app_dev@localhost:5432/shop_dev
# Migration connection: the shop_owner role that owns the schema (used by npm run db:migrate only).
DATABASE_OWNER_URL=postgres://shop_owner:shop_owner_dev@localhost:5432/shop_dev

# --- Encryption of contact details ------------------------------------------
# Phone, email and address of customers, suppliers and your business are stored encrypted (AES-256-GCM).
# REQUIRED in production. Generate once and KEEP A SAFE COPY (lost key = those fields cannot be read):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# After adding it to an existing installation, run: npm run db:encrypt-existing
# DATA_ENCRYPTION_KEY=

# --- Web address -------------------------------------------------------------
# Public address(es) of the website, comma-separated. Used for CSRF checks and email links.
APP_ORIGIN=http://localhost:3000
# Name used in emails and AI requests.
# APP_NAME=My Shop
# Behind a reverse proxy / load balancer that sets X-Forwarded-For (enables per-IP rate limits):
# TRUST_PROXY=1

# --- Email (sign-up confirmation, password reset, invitations) ---------------
# Choose ONE provider. Without any, development prints emails to the server log.
EMAIL_FROM=My Shop <no-reply@localhost>

# Option A — any SMTP server (Gmail, Zoho, Brevo, Amazon SES SMTP, your hosting's mail)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-letter-app-password     # Gmail: Google Account → Security → App passwords
# SMTP_SECURE=false                         # true only for port 465

# Option B — Resend (https://resend.com), HTTPS API
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx

# Option C — local test inbox (Mailpit from docker-compose: open http://localhost:8025)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025

# Email verification for new accounts: required | optional | off
# Default: required when an email provider is set, otherwise off.
# EMAIL_VERIFICATION=required

# --- AI assistant (optional: "Summarise my shop") ---------------------------
# Off unless AI_PROVIDER is set. Each business must also turn it on in Settings.
# Pick ONE block. Local models (Ollama, LM Studio) keep all data on your computer.

# Ollama on this computer (https://ollama.com):  ollama pull llama3.2   (or qwen2.5:7b, gemma3)
# AI_PROVIDER=ollama
# AI_MODEL=llama3.2
# AI_BASE_URL=http://localhost:11434/v1      # change if Ollama runs on another PC, e.g. http://192.168.1.10:11434/v1

# LM Studio on this computer (Developer tab → Start server; copy the model id shown there)
# AI_PROVIDER=lmstudio
# AI_MODEL=qwen2.5-7b-instruct
# AI_BASE_URL=http://localhost:1234/v1

# Groq (https://console.groq.com — fast cloud inference; pick a model id from the console)
# AI_PROVIDER=groq
# AI_API_KEY=gsk_xxxxxxxx
# AI_MODEL=llama-3.3-70b-versatile

# OpenRouter (https://openrouter.ai — many models through one key)
# AI_PROVIDER=openrouter
# AI_API_KEY=sk-or-xxxxxxxx
# AI_MODEL=meta-llama/llama-3.3-70b-instruct

# xAI Grok (https://console.x.ai)
# AI_PROVIDER=xai
# AI_API_KEY=xai-xxxxxxxx
# AI_MODEL=grok-model-id-from-console

# OpenAI, or any other OpenAI-compatible server
# AI_PROVIDER=openai          # or: custom (then AI_BASE_URL is required)
# AI_API_KEY=sk-xxxxxxxx
# AI_MODEL=model-id

# Fine-tuning (optional)
# AI_TIMEOUT_MS=120000        # local models on CPU can be slow; raise if you see "took too long"
# AI_MAX_TOKENS=900
# AI_SHARE_NAMES=local-only   # local-only | always | never  (customer/supplier/item names sent to the model?)

# --- Invoice scanning (OCR) --------------------------------------------------
# Folder with eng.traineddata.gz (default: bundled in node_modules)
# OCR_LANG_PATH=

# --- Logging -------------------------------------------------------------------
# LOG_REQUESTS=1
