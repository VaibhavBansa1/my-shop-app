{
  "name": "my-shop-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant Tally-style accounting, inventory and GST billing for shops (Next.js + PostgreSQL).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "db:setup": "bash scripts/db-setup.sh",
    "smoke": "node scripts/smoke.mjs",
    "db:cleanup": "node scripts/cleanup.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.13.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  }
}
