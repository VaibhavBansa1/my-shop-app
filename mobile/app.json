{
  "expo": {
    "name": "My Shop",
    "slug": "my-shop",
    "scheme": "myshop",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "android": {
      "package": "in.lintlab.myshop",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0f766e" },
      "allowBackup": false,
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE"]
    },
    "ios": { "bundleIdentifier": "in.lintlab.myshop", "supportsTablet": false },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      ["expo-image-picker", {
        "cameraPermission": "My Shop uses the camera to scan supplier invoices. Photos are not stored.",
        "photosPermission": "My Shop reads a photo you choose to scan a supplier invoice.",
        "microphonePermission": false
      }]
    ],
    "extra": {
      "apiUrl": "https://YOUR-DOMAIN"
    }
  }
}
